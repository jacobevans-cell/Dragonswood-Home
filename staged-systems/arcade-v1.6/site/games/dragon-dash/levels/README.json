{
  "note": "Built-in levels currently live in game.js so index.html can run without fetch/CORS issues. Custom levels are saved to browser localStorage.",
  "object_schema": {
    "block": {
      "type": "block",
      "x": 1000,
      "y": 570
    },
    "spike": {
      "type": "spike",
      "x": 1100,
      "y": 570
    },
    "saw": {
      "type": "saw",
      "x": 1200,
      "y": 400,
      "r": 32
    },
    "orb": {
      "type": "orb",
      "x": 1300,
      "y": 450,
      "orb": "yellow|blue|pink|green"
    },
    "pad": {
      "type": "pad",
      "x": 1400,
      "y": 590,
      "pad": "yellow|blue|pink"
    },
    "portal_mode": {
      "type": "portal",
      "x": 1500,
      "y": 430,
      "mode": "cube|ship|ball|ufo|wave|robot|spider"
    },
    "portal_gravity": {
      "type": "portal",
      "x": 1600,
      "y": 430,
      "gravity": -1
    },
    "portal_speed": {
      "type": "portal",
      "x": 1700,
      "y": 430,
      "speed": "slow|normal|fast|faster"
    },
    "finish": {
      "type": "finish",
      "x": 5000,
      "y": 390
    }
  }
}